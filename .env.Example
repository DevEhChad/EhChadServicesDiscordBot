# Twitch API credentials (optional - required for Twitch live stream notifications)
# Where to get: Twitch Developer Console (dev.twitch.tv) -> Register an application -> Client ID + New Secret
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# YouTube Data API key (optional - required for YouTube upload AND live stream notifications)
# Both notifiers share this single key.
# Where to get:
#   1. Go to Google Cloud Console (console.cloud.google.com)
#   2. Create or select a project
#   3. APIs & Services -> Library -> search "YouTube Data API v3" -> Enable
#   4. APIs & Services -> Credentials -> Create Credentials -> API key
#   5. (Recommended) Restrict the key to YouTube Data API v3 only
# Note: YouTube channels can be added by Channel ID (UC...), @handle, or username.
#       The bot will auto-resolve usernames/handles to Channel IDs on first use.
YOUTUBE_API_KEY=YOUR_GOOGLE_YOUTUBE_API_KEY

# Optional: Environment name (development/production)
NODE_ENV=development

# ---------------------------------------------------------------------------------
# Notes:
# - Do NOT commit your real .env to source control. This file is a safe example.
# - Copy this file to `.env` in the project root and fill in your real values.
#   The actual .env file is gitignored and will not be committed.
# ---------------------------------------------------------------------------------

# config.json settings (set in config.json, not .env):
#
#   mainServer      - Your Discord server (guild) ID. Commands are registered here.
#   clientId        - Your bot's application/client ID (same as CLIENT_ID above).
#   devs            - Array of Discord user IDs that have bot-owner permissions.
#   statusChannelId - Channel ID where the bot posts an embed when it comes online.
#                     Leave as "" to disable the startup message.
#   disableKickNotifier - Set to true to completely disable the Kick live notifier.
#
# Kick notifier env override (alternative to config.json):
# DISABLE_KICK_NOTIFIER=true
