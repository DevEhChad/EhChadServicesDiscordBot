# EhChadServicesDiscordBot — example environment variables
# Copy this file to .env and fill in real values. Do NOT commit your .env file.

#########################
# Required (core)
#########################
# Discord bot token — from Discord Developer Portal -> Your App -> Bot -> Token
TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# MongoDB connection string — required for persistence features
# Example format (MongoDB Atlas): mongodb+srv://<user>:<pass>@cluster0.mongodb.net/dbname
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

#########################
# Optional (features)
#########################
# Discord application (client) ID — used for REST calls and command registration
CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID

# Bot owner Discord user ID — used to restrict owner-only commands
BOT_OWNER_ID=YOUR_DISCORD_USER_ID

# Twitch API credentials — required for Twitch now-live notifier
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# YouTube Data API key — required for YouTube upload notifier
YOUTUBE_API_KEY=YOUR_GOOGLE_YOUTUBE_API_KEY

#########################
# Environment / toggles
#########################
NODE_ENV=development

# If you need to disable the kick notifier via env (alternative to config.json)
# Set to 'true' to disable
DISABLE_KICK_NOTIFIER=true

#########################
# Notes
#########################
# - After filling the values, save as `.env` in the project root.
# - Keep secrets out of source control. Use .gitignore to exclude your .env.
# - `src/main.js` expects `TOKEN` and `MONGODB_URI` at minimum for normal operation.
# - If any external script expects `DISCORD_TOKEN`, add a line: DISCORD_TOKEN=your_token